# Copie para .env.local e use os valores do painel Connect do Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública canônica do ambiente. Em produção, use o domínio oficial.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# open: cadastro público; invite: somente convite; closed: criação de contas desativada.
# Sem configuração, produção usa invite e desenvolvimento usa open.
SIGNUP_MODE=open

# Opcional. Quando preenchida, habilita o CTA de demonstração na landing page.
NEXT_PUBLIC_DEMO_URL=
